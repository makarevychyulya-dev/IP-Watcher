# Скопіюйте цей файл у .env для запуску на своєму комп’ютері (npm run dev).
# На Render ці значення вводяться в розділі Environment, файл .env туди не завантажується.

# Обов’язково: ключ Claude API з console.anthropic.com
ANTHROPIC_API_KEY=

# Необов’язково: пароль, без якого сайт не запускатиме пошук
ACCESS_PASSWORD=

# Необов’язково: ліміти запитів до Claude (одна перевірка = 3–4 запити)
RATE_LIMIT_PER_HOUR=30
DAILY_LIMIT=300

# Необов’язково: інша модель Claude
# ANTHROPIC_MODEL=claude-sonnet-5-5
